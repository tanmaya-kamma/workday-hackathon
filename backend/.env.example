# =============================================================================
# Workday Leave Management System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -- Application --
APP_NAME=Workday Leave Management System
APP_VERSION=0.1.0
DEBUG=true

# -- MongoDB Atlas --
# Get this from your teammate who set up the cluster.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=workday_leave_mgmt

# -- JWT Authentication --
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# -- Redis (optional) --
# Leave empty or comment out if Redis is not available.
# The app will gracefully fallback to no-cache mode.
REDIS_URL=redis://localhost:6379/0

# -- CORS --
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Celery (optional) --
CELERY_BROKER_URL=redis://localhost:6379/1

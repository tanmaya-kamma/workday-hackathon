# =============================================================================
# Workday Leave Management System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -- Application --
APP_NAME=Workday Leave Management System
APP_VERSION=0.1.0
DEBUG=true

# -- MongoDB Atlas --
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=LMS

# -- JWT Authentication --
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# -- CORS --
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -- Jira Cloud: Workday LearnTracker (KAN) --
# Create a Jira API token at https://id.atlassian.com/manage-profile/security/api-tokens
# Never commit the real token. Put it only in backend/.env.
JIRA_BASE_URL=https://meiyappansworkspace-43655612.atlassian.net
JIRA_PROJECT_KEY=KAN
JIRA_EMAIL=your-atlassian-account@example.com
JIRA_API_TOKEN=replace-with-your-jira-api-token

# -- Recommender Agent LLM (any OpenAI-compatible provider) --
# Default: Google Gemini FREE tier — create a key (no credit card) at
# https://aistudio.google.com/apikey
# Never commit the real key. Put it only in backend/.env.
# If LLM_API_KEY is left empty, the recommender falls back to rule-based
# recommendations.
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Alternative free provider (Groq — https://console.groq.com/keys):
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_BASE_URL=https://api.groq.com/openai/v1
# Paid OpenAI:
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://api.openai.com/v1
